# Backend environment variables (copy to .env and fill in)
# Upstox API access token (regenerate the one you shared; keep this secret)
UPSTOX_TOKEN=your_upstox_access_token_here

# Supabase Postgres connection string (Project Settings -> Database -> Connection string).
# Use the "Session pooler" URI (IPv4-friendly). The user is `postgres.<PROJECT_REF>`
# and the host is `aws-<N>-<REGION>.pooler.supabase.com`. Note the +pg8000 suffix.
DATABASE_URL=postgresql+pg8000://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:5432/postgres

# Comma-separated allowed CORS origins for the frontend
CORS_ORIGINS=http://localhost:5173

# Quote cache TTL in seconds
QUOTE_CACHE_TTL=60

# --- Alerts ---
# Telegram delivery (optional). Leave blank to use browser push/toast only.
# Create a bot via @BotFather to get the token; get your chat id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Seconds between background alert evaluations
ALERT_POLL_SECONDS=60
# Master switch for the in-process alert scheduler
ALERTS_ENABLED=true
# Shared secret for the external cron trigger POST /alerts/run (sent as the
# X-Cron-Secret header). Leave blank to disable that endpoint (returns 404).
# Use on free-tier hosts where the in-process scheduler sleeps.
CRON_SECRET=
